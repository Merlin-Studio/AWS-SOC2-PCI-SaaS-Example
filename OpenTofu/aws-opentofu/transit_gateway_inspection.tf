# Inter-region peering route-table wiring (centralized egress). The peering
# attachment + accepter come from transit_gateway.tf; here we associate the
# peering to a route table on each side and add the cross-region routes:
#   - primary side: associate the peering to the spokes domain so DR traffic
#     arriving over the peering falls into the same 0.0.0.0/0 -> inspection
#     static route as any local spoke;
#   - secondary side: associate the peering to the DR association table and
#     send its 0.0.0.0/0 over the peering (DR egress is inspected in the
#     primary region);
#   - primary inspection domain: route each secondary CIDR back over the
#     peering (the post-firewall return path).

# ---------------------------------------------------------------------------
# Spoke VPC default routes — push each spoke's 0.0.0.0/0 at the Transit Gateway
# (the TGW spoke domain then static-routes it to the inspection attachment, so
# all spoke egress is inspected). Applied to the spoke's private route tables;
# isolated subnets stay isolated. The count handles spokes with no private tier.
# ---------------------------------------------------------------------------
resource "aws_route" "hub_default_to_tgw" {
  count                  = length(module.vpc_hub.private_route_table_ids)
  provider               = aws.network
  route_table_id         = module.vpc_hub.private_route_table_ids[count.index]
  destination_cidr_block = "0.0.0.0/0"
  transit_gateway_id     = aws_ec2_transit_gateway.primary.id
  depends_on             = [aws_ec2_transit_gateway_vpc_attachment.hub_tgw]
}
