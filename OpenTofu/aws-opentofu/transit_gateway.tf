resource "aws_ec2_transit_gateway" "primary" {
  # checkov:skip=CKV_AWS_331: RAM share is locked to org principal; trust boundary is the org, auto-accept is intentional
  provider                        = aws.network
  description                     = "main-tgw (us-east-1)"
  amazon_side_asn                 = 64512
  auto_accept_shared_attachments  = "enable"
  default_route_table_association = "disable"
  default_route_table_propagation = "disable"
  dns_support                     = "enable"
  vpn_ecmp_support                = "enable"
  tags = merge(local.default_tags, { Name = "main-tgw" })
}


# Share main-tgw with the org via RAM so workload accounts can attach.
resource "aws_ram_resource_share" "primary" {
  provider                  = aws.network
  name                      = "main-tgw-share"
  allow_external_principals = false
  tags                      = local.default_tags
}

resource "aws_ram_resource_association" "primary" {
  provider           = aws.network
  resource_arn       = aws_ec2_transit_gateway.primary.arn
  resource_share_arn = aws_ram_resource_share.primary.arn
}
data "aws_organizations_organization" "current_for_primary" {
  provider = aws.network
}

resource "aws_ram_principal_association" "primary_org" {
  provider           = aws.network
  principal          = data.aws_organizations_organization.current_for_primary.arn
  resource_share_arn = aws_ram_resource_share.primary.arn
}

