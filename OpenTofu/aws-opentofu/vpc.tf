  flow_log_cloudwatch_log_group_retention_in_days = 365

  tags = merge(local.default_tags, {
    Name        = "workloads-sbx"
    Account     = "AppSandbox"
    Region      = "us-east-1"
  })
}

# Gateway VPC endpoints — keep S3 and DynamoDB traffic on the AWS backbone
# (free) instead of routing through NAT (per-GB egress).
resource "aws_vpc_endpoint" "workloads_sbx_s3" {
  provider          = aws.appsandbox
  vpc_id            = module.vpc_workloads_sbx.vpc_id
  service_name      = "com.amazonaws.us-east-1.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = module.vpc_workloads_sbx.private_route_table_ids
  tags = merge(local.default_tags, { Name = "workloads-sbx-s3-endpoint" })
}

resource "aws_vpc_endpoint" "workloads_sbx_dynamodb" {
  provider          = aws.appsandbox
  vpc_id            = module.vpc_workloads_sbx.vpc_id
  service_name      = "com.amazonaws.us-east-1.dynamodb"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = module.vpc_workloads_sbx.private_route_table_ids
  tags = merge(local.default_tags, { Name = "workloads-sbx-dynamodb-endpoint" })
}


# Default-VPC purge (CIS / FedRAMP baseline)
data "aws_vpc" "default" {
  default = true
}

resource "null_resource" "delete_default_vpc_marker" {
  # Tofu can't delete the default VPC directly; document the gap for the operator.
  triggers = {
    note = "Default VPC ${data.aws_vpc.default.id} must be deleted out-of-band. Run scripts/delete-default-vpcs.sh."
  }
}
